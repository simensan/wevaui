; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Weva Godot Host"
; The gallery, so that opening the project and pressing Play shows the sample
; corpus. The other two scenes are for machines and are named explicitly:
;   --headless --scene res://test_scene.tscn --quit-after 2   (the ABI suite)
;   --scene res://capture.tscn -- --html ... --out ...        (one page to a file)
run/main_scene="res://gallery.tscn"
config/features=PackedStringArray("4.7")

[display]

; Room for a 1280x720 document at 1:1 beside the 220px sample list. The gallery
; scales the page to fit whatever size the window ends up, so this is a
; comfortable default rather than a requirement.
window/size/viewport_width=1520
window/size/viewport_height=800

[rendering]

renderer/rendering_method="mobile"
